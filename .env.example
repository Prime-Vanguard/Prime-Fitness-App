# Browser-visible values from your existing Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server environment: use the same project URL and publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never prefix this with VITE_ or put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key

# Sentry error monitoring (EU region). Leave the DSN empty to turn monitoring off.
# The DSN is public. Set the release to the commit SHA in CI.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
# Source-map upload only: a CI secret. Never prefix this with VITE_.
SENTRY_AUTH_TOKEN=
